# Turso database (required)
DATABASE_URL=libsql://your-db-name-your-org.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token-here

# Admin secret (required) — used to authorize admin API requests.
# Generate a strong random string, e.g. `openssl rand -hex 32`
ADMIN_SECRET=replace-with-a-strong-random-secret

# Default admin credentials (required for first seed)
ADMIN_EMAIL=admin@mangabangla.com
ADMIN_PASSWORD=admin123
